# NEVER commit .env — only commit .env.example
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp
DB_USER=app_user
DB_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change_me
JWT_EXPIRES_IN=24h

# App
APP_NAME=my-node-app
APP_VERSION=1.0.0
